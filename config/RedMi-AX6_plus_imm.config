# ============================================================
# RedMi-AX6 / qualcommax-ipq807x —— 修正版（对应 config/RedMi-AX6_plus_imm.config）
#
# 相对原文件的改动只有 3 处，其余保持不动：
#   1) + CONFIG_TARGET_ROOTFS_INITRAMFS=y   → 产出 initramfs 救援镜像
#      （原文件是 not set，导致 build.sh 里找 *.itb 永远扑空，也没有恢复手段）
#   2) - CONFIG_PACKAGE_kmod-oaf=y          → 改为 not set
#      （appfilter 挂 netfilter hook，与 nft tproxy + 直播长连接不合；
#        且 custom_feed 里该包叫 open-app-filter，kmod-oaf 很可能只是个空符号）
#   3) + CONFIG_PACKAGE_dnsmasq_full=y      → 显式锁定 dnsmasq-full
#      （PassWall 的 nftset 分流需要 full 版；依赖里虽已带，显式写死更稳）
#
# ⚠ 设备选择：redmi_ax6 = U-Boot 布局，redmi_ax6-stock = 原厂分区布局。
#   两种固件文件名只差一个后缀，刷错要上 UART/TFTP。
#   确认当前布局后，把不属于你的那组「三行」整组删掉，只编一个。
# ============================================================

CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq807x=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_redmi_ax6-stock=y
CONFIG_TARGET_DEVICE_PACKAGES_qualcommax_ipq807x_DEVICE_redmi_ax6-stock="ipq-wifi-redmi_ax6"
CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_redmi_ax6=y
CONFIG_TARGET_DEVICE_PACKAGES_qualcommax_ipq807x_DEVICE_redmi_ax6="ipq-wifi-redmi_ax6"
CONFIG_DEVEL=y
CONFIG_TOOLCHAINOPTS=y
CONFIG_BUSYBOX_CUSTOM=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_BUSYBOX_CONFIG_TELNET=y
CONFIG_CCACHE=y
CONFIG_GCC_USE_VERSION_13=y
CONFIG_GCC_VERSION="13.4.0"
CONFIG_GCC_VERSION_13=y
CONFIG_KERNEL_PREEMPT=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_bc=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_conntrack=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_default-settings=y
